{
  "name": "@devcrabs/yandex-metrika-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Yandex Metrika (Яндекс Метрика) MCP server: verifiable reports, period comparisons and time series with explicit data quality.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "yandex-metrika-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "lefthook": "2.2.2",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
