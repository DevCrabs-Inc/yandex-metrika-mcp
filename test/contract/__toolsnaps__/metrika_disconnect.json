{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Disconnect"
  },
  "description": "Ends a connection on this computer: cancels its exports, deletes its token and clears its cache. Data already shown in the chat cannot be recalled. Revoking app access inside Yandex is a separate step for the user.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "connection_id": {
        "description": "Connection ID from metrika_status (e.g. conn_demo).",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "connection_id"
    ],
    "type": "object"
  },
  "name": "metrika_disconnect",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "artifacts_kept": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "file_path": {
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "file_path",
            "expires_at"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "cache_cleared": {
        "type": "boolean"
      },
      "connection_id": {
        "type": "string"
      },
      "jobs_cancelled": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "kind": {
        "const": "disconnect",
        "type": "string"
      },
      "notes": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "schema_version": {
        "type": "string"
      },
      "token_deleted": {
        "type": "boolean"
      }
    },
    "required": [
      "schema_version",
      "kind",
      "connection_id",
      "token_deleted",
      "cache_cleared",
      "jobs_cancelled",
      "artifacts_kept",
      "notes"
    ],
    "type": "object"
  },
  "title": "Yandex Metrika: disconnect"
}
