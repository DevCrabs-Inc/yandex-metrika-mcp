{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true,
    "title": "Status"
  },
  "description": "Shows Yandex Metrika connections (connection_id values) and their state, export jobs, capabilities and the next step. Call it first; works before any Yandex sign-in.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "connection_id": {
        "description": "Limit the status to one connection.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "metrika_status",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "capabilities": {
        "additionalProperties": false,
        "properties": {
          "browser_sign_in": {
            "type": "boolean"
          },
          "demo": {
            "type": "boolean"
          },
          "exports": {
            "type": "boolean"
          },
          "prompts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "read_only": {
            "const": true,
            "type": "boolean"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "tools",
          "prompts",
          "browser_sign_in",
          "demo",
          "exports",
          "read_only"
        ],
        "type": "object"
      },
      "connections": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "alias": {
              "type": "string"
            },
            "allowed_counters": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "null: every counter the account can see."
            },
            "connection_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "demo",
                "env",
                "oauth",
                "token"
              ],
              "type": "string"
            },
            "state": {
              "enum": [
                "active",
                "needs_reconnect"
              ],
              "type": "string"
            },
            "token_expires_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "connection_id",
            "alias",
            "kind",
            "state",
            "token_expires_at",
            "allowed_counters"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "jobs": {
        "additionalProperties": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "description": "Export jobs by state.",
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "kind": {
        "const": "status",
        "type": "string"
      },
      "next_actions": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "notes": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "pending_sign_ins": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "connection_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "expires_at": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "expires_at",
            "connection_id"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "schema_version": {
        "type": "string"
      },
      "server": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      }
    },
    "required": [
      "schema_version",
      "kind",
      "server",
      "capabilities",
      "connections",
      "pending_sign_ins",
      "jobs",
      "next_actions",
      "notes"
    ],
    "type": "object"
  },
  "title": "Yandex Metrika: status"
}
