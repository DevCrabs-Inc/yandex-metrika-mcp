                          "string",
                          "null"
                        ]
                      },
                      "redacted": {
                        "type": "boolean"
                      },
                      "truncated": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "key": {
                  "type": "string"
                },
                "values": {
                  "items": {
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "type": "array"
                  },
                  "type": "array"
                }
              },
              "required": [
                "key",
                "dimensions",
                "values"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "totals": {
            "description": "Per metric, one value per bucket, over all data.",
            "items": {
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "columns",
          "axis_source",
          "buckets",
          "totals",
          "period_totals",
          "series"
        ],
        "type": "object"
      },
      "kind": {
        "const": "timeseries",
        "type": "string"
      },
