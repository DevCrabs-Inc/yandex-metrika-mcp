{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true,
    "title": "Time series"
  },
  "description": "Metric dynamics in day, week or month buckets with exact calendar boundaries in the counter time zone (weekly series must start on a Monday). Flags buckets that include today or are clipped by the period. Optional dimensions return top-N segment series. Default: last 28 complete days by day.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "accuracy": {
        "description": "strict (default): fail instead of returning sampled data. balanced: accept sampling with a warning.",
        "enum": [
          "strict",
          "balanced"
        ],
        "type": "string"
      },
      "cache": {
        "description": "default: reuse fresh cached results; refresh: always ask the API; allow_stale: fall back to older cached data if the API is down.",
        "enum": [
          "default",
          "refresh",
          "allow_stale"
        ],
        "type": "string"
      },
      "connection_id": {
        "description": "Connection ID from metrika_status (e.g. conn_demo).",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "counter_id": {
        "description": "Counter ID as a string, from metrika_list_counters.",
        "pattern": "^\\d{1,12}$",
        "type": "string"
      },
      "dimensions": {
        "description": "Dimension IDs.",
        "items": {
          "type": "string"
        },
        "maxItems": 10,
        "type": "array"
      },
      "filters": {
        "description": "Conditions combined with AND.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "description": "Dimension ID from metrika_catalog.",
              "type": "string"
            },
            "op": {
              "description": "eq, neq, contains and not_contains take one value; in and not_in take several.",
              "enum": [
                "eq",
                "neq",
                "contains",
                "not_contains",
                "in",
                "not_in"
              ],
              "type": "string"
            },
            "values": {
              "description": "Values to compare with.",
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "dimension",
            "op",
            "values"
          ],
          "type": "object"
        },
        "maxItems": 10,
        "type": "array"
      },
      "goal_ids": {
        "description": "Goal IDs (not names) from metrika_describe_counter; adds goal columns to a preset.",
        "items": {
          "pattern": "^\\d{1,12}$",
          "type": "string"
        },
        "maxItems": 6,
        "type": "array"
      },
      "group": {
        "description": "Bucket size, default day.",
        "enum": [
          "day",
          "week",
          "month"
        ],
        "type": "string"
      },
      "metrics": {
        "description": "Metric IDs (e.g. ym:s:visits, ym:s:goal<ID>visits) when no preset is used.",
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
      },
      "period": {
        "additionalProperties": false,
        "description": "Either {preset} or {start, end}. Dates are in the counter time zone. Default: last_7_complete_days.",
        "properties": {
          "end": {
            "description": "YYYY-MM-DD, inclusive.",
            "type": "string"
          },
          "preset": {
            "description": "Named period; metrika_catalog kind='periods' lists them.",
            "enum": [
              "today",
              "yesterday",
              "last_7_complete_days",
              "last_28_complete_days",
              "last_complete_iso_week",
              "last_complete_month"
            ],
            "type": "string"
          },
          "start": {
            "description": "YYYY-MM-DD, inclusive.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "preset": {
        "description": "Ready-made report. Mutually exclusive with metrics/dimensions.",
        "enum": [
          "overview",
          "acquisition",
          "landing_pages",
          "devices",
          "geography",
          "goals"
        ],
        "type": "string"
      },
      "top_keys": {
        "description": "With dimensions: number of segment series (largest first), default 5.",
        "maximum": 10,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "connection_id",
      "counter_id"
    ],
    "type": "object"
  },
  "name": "metrika_run_timeseries",
  "outputSchema": {
