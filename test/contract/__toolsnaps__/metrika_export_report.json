{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false,
    "title": "Export report"
  },
  "description": "Exports all rows of a Yandex Metrika report to a CSV or JSON file in the background and returns a job. Requires idempotency_key; the same key returns the same job. To continue an interrupted export pass only connection_id and resume_job_id. Poll metrika_get_job until completed, then read with metrika_read_artifact or give the user file_path.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "accuracy": {
        "description": "strict (default): fail instead of returning sampled data. balanced: accept sampling with a warning.",
        "enum": [
          "strict",
          "balanced"
        ],
        "type": "string"
      },
      "connection_id": {
        "description": "Connection ID from metrika_status (e.g. conn_demo).",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "counter_id": {
        "description": "Counter ID as a string, from metrika_list_counters.",
        "pattern": "^\\d{1,12}$",
        "type": "string"
      },
      "dimensions": {
        "description": "Dimension IDs.",
        "items": {
          "type": "string"
        },
        "maxItems": 10,
        "type": "array"
      },
      "filters": {
        "description": "Conditions combined with AND.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "dimension": {
              "description": "Dimension ID from metrika_catalog.",
              "type": "string"
            },
            "op": {
              "description": "eq, neq, contains and not_contains take one value; in and not_in take several.",
              "enum": [
                "eq",
                "neq",
                "contains",
                "not_contains",
                "in",
                "not_in"
              ],
              "type": "string"
            },
            "values": {
              "description": "Values to compare with.",
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "dimension",
            "op",
            "values"
          ],
          "type": "object"
        },
        "maxItems": 10,
        "type": "array"
      },
      "format": {
        "description": "csv (default), csv_excel_safe (BOM + formula guard for Excel) or json (exact values).",
        "enum": [
          "csv",
          "csv_excel_safe",
          "json"
        ],
        "type": "string"
      },
      "goal_ids": {
        "description": "Goal IDs (not names) from metrika_describe_counter; adds goal columns to a preset.",
        "items": {
          "pattern": "^\\d{1,12}$",
          "type": "string"
        },
        "maxItems": 6,
        "type": "array"
      },
      "idempotency_key": {
        "description": "Required for a new export. Repeating the same key returns the same job.",
        "maxLength": 128,
        "minLength": 8,
        "type": "string"
      },
      "metrics": {
        "description": "Metric IDs (e.g. ym:s:visits, ym:s:goal<ID>visits) when no preset is used.",
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array"
      },
      "period": {
        "additionalProperties": false,
        "description": "Either {preset} or {start, end}. Dates are in the counter time zone. Default: last_7_complete_days.",
        "properties": {
          "end": {
            "description": "YYYY-MM-DD, inclusive.",
            "type": "string"
          },
          "preset": {
            "description": "Named period; metrika_catalog kind='periods' lists them.",
            "enum": [
              "today",
              "yesterday",
              "last_7_complete_days",
              "last_28_complete_days",
              "last_complete_iso_week",
              "last_complete_month"
            ],
            "type": "string"
          },
          "start": {
            "description": "YYYY-MM-DD, inclusive.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "preset": {
        "description": "Ready-made report. Mutually exclusive with metrics/dimensions.",
        "enum": [
          "overview",
          "acquisition",
          "landing_pages",
          "devices",
          "geography",
          "goals"
        ],
        "type": "string"
      },
      "resume_job_id": {
        "description": "Continue an interrupted export. Pass only connection_id and resume_job_id.",
        "pattern": "^job_[a-z0-9]{6,40}$",
        "type": "string"
      },
      "sort": {
        "description": "Field IDs; prefix with '-' for descending. Default: first metric descending.",
        "items": {
          "type": "string"
        },
        "maxItems": 5,
        "type": "array"
      }
    },
    "required": [
      "connection_id"
    ],
    "type": "object"
  },
  "name": "metrika_export_report",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "artifacts": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "expires_at": {
              "type": "string"
            },
            "file_path": {
              "description": "Local file the user can open; managed copy, deleted at expires_at.",
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "rows": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            },
            "size_bytes": {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "artifact_id",
            "uri",
            "file_path",
            "media_type",
            "size_bytes",
            "sha256",
            "rows",
            "expires_at"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "connection_id": {
        "type": "string"
      },
      "created_at": {
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "AUTH_REQUIRED",
                  "AUTH_EXPIRED",
                  "AUTH_NOT_CONFIGURED",
                  "ACCESS_DENIED",
                  "COUNTER_NOT_ALLOWED",
                  "INVALID_QUERY",
                  "UNSUPPORTED_COMBINATION",
                  "QUALITY_REQUIREMENT_NOT_MET",
                  "TIMEZONE_UNKNOWN",
                  "QUOTA_EXCEEDED",
                  "UPSTREAM_UNAVAILABLE",
                  "UPSTREAM_TIMEOUT",
                  "UPSTREAM_SCHEMA_CHANGED",
                  "RESULT_LIMIT_REACHED",
                  "CURSOR_EXPIRED",
                  "CURSOR_MISMATCH",
                  "JOB_NOT_FOUND",
                  "ARTIFACT_NOT_FOUND",
                  "ARTIFACT_EXPIRED",
                  "STORAGE_LIMIT",
                  "IDEMPOTENCY_CONFLICT",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retry_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "retry_at"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "finished_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "format": {
        "enum": [
          "csv",
          "csv_excel_safe",
          "json"
        ],
        "type": "string"
      },
      "job_id": {
        "type": "string"
      },
      "kind": {
        "const": "job",
        "type": "string"
      },
      "next_action": {
        "type": [
          "string",
          "null"
        ]
      },
      "progress": {
        "additionalProperties": false,
        "properties": {
          "bytes_written": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "parts": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "percent": {
            "description": "Only when the API reports an exact row count.",
            "type": [
              "number",
              "null"
            ]
          },
          "rows_received": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "rows_total": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "rows_total_rounded": {
            "type": "boolean"
          },
          "rows_written": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "rows_received",
          "rows_written",
          "rows_total",
          "rows_total_rounded",
          "bytes_written",
          "parts",
          "percent"
        ],
        "type": "object"
      },
      "query": {
        "additionalProperties": false,
        "properties": {
          "accuracy_requested": {
            "enum": [
              "strict",
              "balanced"
            ],
            "type": "string"
          },
          "counter": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "site": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "site"
            ],
            "type": "object"
          },
          "dimensions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "op": {
                  "enum": [
                    "eq",
                    "neq",
                    "contains",
                    "not_contains",
                    "in",
                    "not_in"
                  ],
                  "type": "string"
                },
                "values": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "dimension",
                "op",
                "values"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "metrics": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "period": {
            "additionalProperties": false,
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "days": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "end": {
                "type": "string"
              },
              "preset": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": "string"
              },
              "time_zone": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "end",
              "time_zone",
              "days",
              "complete",
              "preset"
            ],
            "type": "object"
          },
          "preset": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "counter",
          "period",
          "metrics",
          "dimensions",
          "filters",
          "sort",
          "accuracy_requested",
          "preset"
        ],
        "type": "object"
      },
      "schema_version": {
        "type": "string"
      },
      "stage": {
        "type": "string"
      },
      "state": {
        "enum": [
          "queued",
          "running",
          "waiting_quota",
          "interrupted",
          "partial",
          "failed",
          "cancelled",
          "completed"
        ],
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "warnings": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "affected_fields": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "info",
                "warning"
              ],
              "type": "string"
            }
          },
          "required": [
            "code",
            "severity",
            "message",
            "affected_fields"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "kind",
      "job_id",
      "connection_id",
      "state",
      "stage",
      "format",
      "created_at",
      "updated_at",
      "finished_at",
      "query",
      "progress",
      "error",
      "artifacts",
      "next_action",
      "warnings"
    ],
    "type": "object"
  },
  "title": "Yandex Metrika: export report"
}
