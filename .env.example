# All variables are optional; see docs/ru/configuration.md.
# Your own Yandex OAuth app (public PKCE client, no secret):
YM_MCP_CLIENT_ID=
# Existing OAuth token with metrika:read for headless setups (creates conn_env):
YANDEX_METRIKA_TOKEN=
# auto | keychain | file (file = unencrypted, readable only by your user)
YM_MCP_SECRET_STORE=auto
# ru | en labels from the API
YM_MCP_API_LANG=ru
# safe | full (safe removes URL query strings from labels)
YM_MCP_PRIVACY=safe
YM_MCP_AUTO_RESUME=false
YM_MCP_DEMO=true
YM_MCP_LOG_LEVEL=info
